# Copy this file to ".env" and edit. Never commit ".env".

# PostgreSQL (if your password has special characters like @ or #, URL-encode them)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/fraudlens

# Zero-install fallback (no PostgreSQL needed) - uncomment to use SQLite instead:
# DATABASE_URL=sqlite:///./fraudlens.db

# Notifications: mock | sns | ses   (use mock until AWS credentials exist)
NOTIFICATION_PROVIDER=mock
# AWS_REGION=ap-south-1
# SNS_TOPIC_ARN=
# SES_SENDER=
# SES_RECIPIENTS=["alerts@example.com"]

# Force the built-in mock engine even if Member 1's fraud_engine/ exists
USE_MOCK_ENGINE=false

# Seed demo data automatically on startup when the DB is empty
AUTO_SEED=false

# Lists must be JSON:
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
